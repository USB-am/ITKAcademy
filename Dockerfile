# Используем официальный лёгкий образ Python
FROM python:3.12-slim

# Отключаем буферизацию вывода для логирования в реальном времени
ENV PYTHONUNBUFFERED=1

# Устанавливаем рабочую директорию внутри контейнера
WORKDIR /app

# Копируем файл с зависимостями и устанавливаем их
# (кэширование этого слоя ускоряет пересборку при неизменных зависимостях)
COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# Копируем весь исходный код проекта
COPY . .

# Открываем порт, который будет слушать Uvicorn
EXPOSE 8000

# Команда по умолчанию (будет переопределена в docker-compose для выполнения миграций)
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]